<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WeatherStation.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:WeatherStation.Views"
    Shell.FlyoutBehavior="Disabled"
    Title="Weather Station">

    <TabBar>
        <ShellContent
            Title="Forecast"
            Icon="tab_forecast.png"
            ContentTemplate="{DataTemplate views:ForecastPage}"
            Route="ForecastPage" />
        <ShellContent
            Title="Locations"
            Icon="tab_locations.png"
            ContentTemplate="{DataTemplate views:LocationsPage}"
            Route="LocationsPage" />

        <ShellContent
            Title="Compare"
            Icon="tab_compare.png"
            ContentTemplate="{DataTemplate views:ComparePage}"
            Route="ComparePage" />

        <ShellContent
            Title="Planner"
            Icon="tab_planner.png"
            ContentTemplate="{DataTemplate views:PlannerPage}"
            Route="PlannerPage" />

        <ShellContent
            Title="Settings"
            Icon="tab_settings.png"
            ContentTemplate="{DataTemplate views:SettingsPage}"
            Route="SettingsPage" />
    </TabBar>

</Shell>
