<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherStation.Views.ForecastPage"
             Title="Forecast">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">
            <Label Text="API test (temporary)" FontSize="24" />
            <Picker x:Name="LocationPicker" Title="Choose a location" />
            <Button Text="Fetch forecast" Clicked="OnFetchClicked" />
            <ActivityIndicator x:Name="Spinner" IsRunning="False" />
            <Label x:Name="ResultLabel" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>