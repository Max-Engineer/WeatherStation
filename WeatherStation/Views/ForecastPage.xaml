<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherStation.Views.ForecastPage"
             Title="Forecast">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="10">
            <Label Text="Storage test (temporary)" FontSize="24" />
            <Label x:Name="PathLabel" FontSize="12" TextColor="Gray" />
            <Picker x:Name="LocationPicker" Title="Choose a location" />
            <Button Text="Fetch (saved copy allowed)" Clicked="OnFetchClicked" />
            <Button Text="Force refresh" Clicked="OnRefreshClicked" />
            <Button Text="Toggle favourite" Clicked="OnFavouriteClicked" />
            <Button Text="Toggle temperature unit (test)" Clicked="OnToggleUnitClicked" />
            <Button Text="Show saved data" Clicked="OnShowSavedClicked" />
            <ActivityIndicator x:Name="Spinner" IsRunning="False" />
            <Label x:Name="ResultLabel" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>